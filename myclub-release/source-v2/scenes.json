{"intro": "<!-- 1 INTRO -->\n<section class=\"scene dark\" data-dur=\"4.6\" id=\"intro\">\n  <div class=\"glow\" data-drift=\"1\" style=\"width:1300px;height:1300px;left:-200px;top:-500px\"></div>\n  <div class=\"glow\" data-drift=\"-1\" style=\"width:1100px;height:1100px;right:-300px;bottom:-500px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:0;right:0;top:300px;text-align:center\">\n      <div class=\"eyebrow\" data-in=\"0.3\">Introducing</div>\n      <div class=\"serif\" data-in=\"0.7\" data-y=\"50\" style=\"font-size:230px;font-weight:500;line-height:1.05;margin-top:24px;letter-spacing:-.02em\">my<span class=\"copper it\">club</span></div>\n      <div class=\"p\" data-in=\"1.5\" style=\"margin-top:28px;font-size:34px;color:var(--copper2)\">Guest engagement for restaurants, by qlub</div>\n    </div>\n  </div>\n</section>", "hook": "<!-- 2 HOOK -->\n<section class=\"scene dark\" data-dur=\"5\" id=\"hook\">\n  <div class=\"glow\" data-drift=\"1\" style=\"width:1400px;height:1400px;left:700px;top:-300px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:180px;top:330px;right:180px\">\n      <h1 data-in=\"0.2\" style=\"font-size:110px;line-height:1.1\">Loyalty isn\u2019t the product.</h1>\n      <h1 data-in=\"1.3\" class=\"copper it\" style=\"font-size:110px;line-height:1.1\">Knowing your guest is.</h1>\n      <div class=\"p\" data-in=\"2.5\" style=\"margin-top:48px;max-width:1200px\">myclub sits on the qlub checkout your guests already use. No app to build, no POS change, no hardware.</div>\n    </div>\n  </div>\n</section>", "pillars": "<!-- 3 PILLARS -->\n<section class=\"scene dark\" data-dur=\"7\" id=\"pillars\">\n  <div class=\"glow\" data-drift=\"1\" style=\"width:1200px;height:1200px;left:-400px;top:300px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:140px;top:130px;right:140px\">\n      <div class=\"eyebrow\" data-in=\"0.1\">What myclub is</div>\n      <h2 data-in=\"0.3\" style=\"margin-top:22px\">Four things, on the checkout you already run.</h2>\n    </div>\n    <div class=\"abs row\" style=\"left:140px;right:140px;top:440px;gap:32px\">\n      <div class=\"card-d\" data-in=\"1.0\" data-y=\"60\" style=\"flex:1;padding:44px 40px;height:440px\">\n        <div class=\"ico\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6\"/></svg></div>\n        <div class=\"num\" style=\"font-size:24px;margin-top:40px\">01</div>\n        <div class=\"serif\" style=\"font-size:40px;margin-top:10px;min-height:100px;line-height:1.2\">Identify your guest</div>\n        <div class=\"p\" style=\"font-size:23px;margin-top:16px\">They join in three taps at the table, and you know them every visit after.</div>\n      </div>\n      <div class=\"card-d\" data-in=\"1.35\" data-y=\"60\" style=\"flex:1;padding:44px 40px;height:440px\">\n        <div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 5h16v11H9l-5 4z\"/><path d=\"M8 10h8M8 13h5\"/></svg></div>\n        <div class=\"num\" style=\"font-size:24px;margin-top:40px\">02</div>\n        <div class=\"serif\" style=\"font-size:40px;margin-top:10px;min-height:100px;line-height:1.2\">Engage with them</div>\n        <div class=\"p\" style=\"font-size:23px;margin-top:16px\">Reviews at the happiest moment, then offers, new menus and events.</div>\n      </div>\n      <div class=\"card-d\" data-in=\"1.7\" data-y=\"60\" style=\"flex:1;padding:44px 40px;height:440px\">\n        <div class=\"ico\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v8M9.5 10.5h4a1.5 1.5 0 010 3h-3\"/></svg></div>\n        <div class=\"num\" style=\"font-size:24px;margin-top:40px\">03</div>\n        <div class=\"serif\" style=\"font-size:40px;margin-top:10px;min-height:100px;line-height:1.2\">Reward the visit</div>\n        <div class=\"p\" style=\"font-size:23px;margin-top:16px\">Coins under your own brand, earned and burned in a tap.</div>\n      </div>\n      <div class=\"card-d\" data-in=\"2.05\" data-y=\"60\" style=\"flex:1;padding:44px 40px;height:440px\">\n        <div class=\"ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 19h4v-5h4V9h4V5h4\"/></svg></div>\n        <div class=\"num\" style=\"font-size:24px;margin-top:40px\">04</div>\n        <div class=\"serif\" style=\"font-size:40px;margin-top:10px;min-height:100px;line-height:1.2\">Build the habit</div>\n        <div class=\"p\" style=\"font-size:23px;margin-top:16px\">Points and tiers turn a good visit into the next one.</div>\n      </div>\n    </div>\n  </div>\n</section>", "journey": "<!-- 4 JOURNEY -->\n<section class=\"scene light\" data-dur=\"7.5\" id=\"journey\">\n  <div class=\"glow\" data-drift=\"1\" style=\"width:1300px;height:1300px;left:900px;top:-200px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:150px;top:200px;width:900px\">\n      <div class=\"eyebrow\" data-in=\"0.1\">The journey</div>\n      <h2 data-in=\"0.3\" style=\"margin-top:22px\">Just scan.<br>Everything is in place.</h2>\n      <div style=\"margin-top:64px\">\n        <div class=\"step row\" data-in=\"0.9\" style=\"gap:28px;align-items:center;padding:22px 28px;border-radius:22px\">\n          <div class=\"dot serif\" style=\"width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px\">1</div>\n          <div><div style=\"font-size:32px;font-weight:600\">Scan the QR</div><div class=\"p\" style=\"font-size:22px\">The bill and the offer to join open together.</div></div>\n        </div>\n        <div class=\"step row\" data-in=\"1.1\" style=\"gap:28px;align-items:center;padding:22px 28px;border-radius:22px;margin-top:10px\">\n          <div class=\"dot serif\" style=\"width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px\">2</div>\n          <div><div style=\"font-size:32px;font-weight:600\">Sign up</div><div class=\"p\" style=\"font-size:22px\">Tap Join, enter the code, done.</div></div>\n        </div>\n        <div class=\"step row\" data-in=\"1.3\" style=\"gap:28px;align-items:center;padding:22px 28px;border-radius:22px;margin-top:10px\">\n          <div class=\"dot serif\" style=\"width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px\">3</div>\n          <div><div style=\"font-size:32px;font-weight:600\">Earn and redeem instantly</div><div class=\"p\" style=\"font-size:22px\">Coins land on the bill in front of them, then they pay as usual.</div></div>\n        </div>\n      </div>\n    </div>\n    <img src=\"assets/phone.jpg\" data-in=\"0.4\" data-y=\"160\" data-d=\"1.1\" class=\"abs\" style=\"left:1210px;top:70px;height:950px;mix-blend-mode:multiply\">\n    <div class=\"abs pill\" data-in=\"5.0\" data-y=\"20\" data-pop=\"1\" style=\"left:1090px;top:560px;background:var(--ink);color:var(--cream);box-shadow:0 18px 40px rgba(0,0,0,.25);font-size:26px;padding:18px 30px\">\n      <span style=\"width:34px;height:34px;border-radius:50%;background:var(--copper);display:inline-flex;align-items:center;justify-content:center;font-family:Gelasio;font-size:20px;color:var(--ink)\">B</span>\n      +100 coins earned\n    </div>\n  </div>\n</section>", "profile": "<!-- 5 PROFILE -->\n<section class=\"scene dark\" data-dur=\"7.5\" id=\"profile\">\n  <div class=\"glow\" data-drift=\"-1\" style=\"width:1300px;height:1300px;left:-300px;top:-300px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:140px;top:250px;width:720px\">\n      <div class=\"eyebrow\" data-in=\"0.1\">History &amp; insights</div>\n      <h2 data-in=\"0.3\" style=\"margin-top:22px\">The table stops being anonymous.</h2>\n      <div class=\"p\" data-in=\"0.8\" style=\"margin-top:32px\">When a member scans, your host and your floor see the same profile the dashboard does: who they are, what they love, what they told you last time.</div>\n    </div>\n    <div class=\"abs card-l\" data-in=\"0.6\" data-y=\"80\" data-d=\"0.9\" style=\"left:960px;top:150px;width:820px;padding:44px;color:var(--ink)\">\n      <div class=\"row\" style=\"align-items:center;gap:24px\">\n        <div style=\"width:88px;height:88px;border-radius:50%;background:#F3E3D2;color:#9A5A26;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:30px\">LH</div>\n        <div style=\"flex:1\">\n          <div class=\"row\" style=\"align-items:center;gap:14px\"><span style=\"font-size:36px;font-weight:600\">Layla H.</span>\n            <span class=\"pill\" style=\"background:var(--ink);color:var(--copper2);font-size:18px;padding:6px 16px\">Elite</span>\n            <span class=\"pill\" style=\"background:#E5F2E8;color:#2F7A46;font-size:18px;padding:6px 16px\">Top 3% spend</span></div>\n          <div class=\"muted\" style=\"font-size:20px;margin-top:6px\">Member since Mar 2026 \u00b7 Table 12 \u00b7 seated 7:04 PM</div>\n        </div>\n      </div>\n      <div class=\"row\" style=\"margin-top:36px;border-top:1px solid var(--line-l);border-bottom:1px solid var(--line-l);padding:28px 0\">\n        <div style=\"flex:1\"><div class=\"muted\" style=\"font-size:16px;letter-spacing:.16em;font-weight:600\">VISITS</div><div class=\"serif\" style=\"font-size:56px;margin-top:6px\"><span data-count=\"27\" data-cin=\"1.3\"></span></div></div>\n        <div style=\"flex:1.4\"><div class=\"muted\" style=\"font-size:16px;letter-spacing:.16em;font-weight:600\">LIFETIME SPEND</div><div class=\"serif\" style=\"font-size:56px;margin-top:6px\"><span data-count=\"9340\" data-pre=\"AED \" data-cin=\"1.3\"></span></div></div>\n        <div style=\"flex:1.2\"><div class=\"muted\" style=\"font-size:16px;letter-spacing:.16em;font-weight:600\">COIN BALANCE</div><div class=\"serif copper\" style=\"font-size:56px;margin-top:6px\"><span data-count=\"2071\" data-cin=\"1.3\"></span></div></div>\n      </div>\n      <div class=\"muted\" style=\"font-size:16px;letter-spacing:.16em;font-weight:600;margin-top:28px\">GUEST INSIGHTS</div>\n      <div class=\"row\" style=\"gap:16px;margin-top:16px\">\n        <div data-in=\"2.6\" data-y=\"20\" style=\"flex:1;background:#F4F1EC;border-radius:18px;padding:20px 22px;font-size:22px;line-height:1.35\">Always orders sparkling water with lemon</div>\n        <div data-in=\"3.0\" data-y=\"20\" style=\"flex:1;background:#F4F1EC;border-radius:18px;padding:20px 22px;font-size:22px;line-height:1.35\">Ordered the almond croissant 5 times</div>\n      </div>\n      <div data-in=\"3.7\" data-y=\"20\" class=\"row\" style=\"margin-top:16px;background:#FBEBDC;border-radius:18px;padding:20px 22px;font-size:22px;line-height:1.35;gap:14px;align-items:center\">\n        <span style=\"font-size:26px\">\u2605</span><span>Two visits from Elite renewal. Worth a dessert on the house tonight.</span>\n      </div>\n    </div>\n  </div>\n</section>", "coins": "<!-- 6 COINS -->\n<section class=\"scene light\" data-dur=\"6.5\" id=\"coins\">\n  <div class=\"glow\" data-drift=\"1\" style=\"width:1200px;height:1200px;right:-300px;top:-400px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:140px;top:130px;right:140px\">\n      <div class=\"eyebrow\" data-in=\"0.1\">Your own coins</div>\n      <h2 data-in=\"0.3\" style=\"margin-top:22px\">Real, spendable value.</h2>\n    </div>\n    <div class=\"abs row\" style=\"left:140px;right:140px;top:400px;gap:32px\">\n      <div data-in=\"0.8\" data-y=\"50\" style=\"flex:1;background:var(--ink);color:var(--cream);border-radius:28px;padding:44px\">\n        <div class=\"serif copper\" style=\"font-size:120px;line-height:1\">1 : 1</div>\n        <div class=\"p\" style=\"font-size:26px;margin-top:20px;color:var(--muted-d)\">1 coin for every AED spent</div>\n      </div>\n      <div data-in=\"1.1\" data-y=\"50\" style=\"flex:1;background:var(--ink);color:var(--cream);border-radius:28px;padding:44px\">\n        <div class=\"serif copper\" style=\"font-size:120px;line-height:1\">20 = 1</div>\n        <div class=\"p\" style=\"font-size:26px;margin-top:20px;color:var(--muted-d)\">20 coins come off the bill as AED 1</div>\n      </div>\n      <div data-in=\"1.4\" data-y=\"50\" style=\"flex:1;background:var(--ink);color:var(--cream);border-radius:28px;padding:44px\">\n        <div class=\"serif copper\" style=\"font-size:120px;line-height:1\">All</div>\n        <div class=\"p\" style=\"font-size:26px;margin-top:20px;color:var(--muted-d)\">One balance across every outlet</div>\n      </div>\n    </div>\n    <div class=\"abs row\" style=\"left:140px;right:140px;top:770px;gap:32px\">\n      <div class=\"card-l\" data-in=\"2.4\" data-y=\"30\" style=\"flex:1;padding:30px 36px\"><div class=\"eyebrow\" style=\"font-size:16px\">Money off</div><div style=\"font-size:26px;font-weight:600;margin-top:10px\">Straight off the bill at checkout</div></div>\n      <div class=\"card-l\" data-in=\"2.7\" data-y=\"30\" style=\"flex:1;padding:30px 36px\"><div class=\"eyebrow\" style=\"font-size:16px\">Vouchers</div><div style=\"font-size:26px;font-weight:600;margin-top:10px\">Experiences on the house</div></div>\n      <div class=\"card-l\" data-in=\"3.0\" data-y=\"30\" style=\"flex:1;padding:30px 36px\"><div class=\"eyebrow\" style=\"font-size:16px\">Gift cards</div><div style=\"font-size:26px;font-weight:600;margin-top:10px\">Value to bank and share</div></div>\n    </div>\n  </div>\n</section>", "tiers": "<!-- 7 TIERS -->\n<section class=\"scene dark\" data-dur=\"7.5\" id=\"tiers\">\n  <div class=\"glow\" data-drift=\"-1\" style=\"width:1400px;height:1400px;right:-400px;bottom:-700px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:140px;top:110px;right:140px\">\n      <div class=\"eyebrow\" data-in=\"0.1\">The tier journey</div>\n      <h2 data-in=\"0.3\" style=\"margin-top:22px\">Earn faster the more they visit.</h2>\n    </div>\n    <div class=\"abs row\" style=\"left:140px;right:140px;bottom:150px;gap:28px;align-items:flex-end;height:640px\">\n      <!-- bars -->\n      <div class=\"tier\" style=\"flex:1\"><div class=\"tl\" data-in=\"0.9\"><div class=\"serif\" style=\"font-size:34px\">Guest</div><div class=\"muted\" style=\"font-size:20px\">0+ visits</div></div>\n        <div class=\"bar\" data-grow=\"0.8\" style=\"height:200px;background:#2A231D\"><div class=\"rate\">1\u00d7</div><div class=\"sub\">coins per AED</div></div></div>\n      <div class=\"tier\" style=\"flex:1\"><div class=\"tl\" data-in=\"1.1\"><div class=\"serif\" style=\"font-size:34px\">Member</div><div class=\"muted\" style=\"font-size:20px\">3+ visits</div></div>\n        <div class=\"bar\" data-grow=\"1.0\" style=\"height:270px;background:#3A2D22\"><div class=\"rate\">1.25\u00d7</div><div class=\"sub\">+250 coin entry bonus</div></div></div>\n      <div class=\"tier\" style=\"flex:1\"><div class=\"tl\" data-in=\"1.3\"><div class=\"serif\" style=\"font-size:34px\">Prime</div><div class=\"muted\" style=\"font-size:20px\">6+ visits</div></div>\n        <div class=\"bar\" data-grow=\"1.2\" style=\"height:340px;background:#5A3D26\"><div class=\"rate\">1.5\u00d7</div><div class=\"sub\">+400 coin entry bonus</div></div></div>\n      <div class=\"tier\" style=\"flex:1\"><div class=\"tl\" data-in=\"1.5\"><div class=\"serif\" style=\"font-size:34px\">Elite</div><div class=\"muted\" style=\"font-size:20px\">15+ visits</div></div>\n        <div class=\"bar\" data-grow=\"1.4\" style=\"height:420px;background:#8A552C\"><div class=\"rate\">2\u00d7</div><div class=\"sub\">+500 coin entry bonus</div><div class=\"perk\" data-in=\"3.0\">Dessert every 2nd visit</div></div></div>\n      <div class=\"tier\" style=\"flex:1\"><div class=\"tl\" data-in=\"1.7\"><div class=\"serif\" style=\"font-size:34px\">Patron</div><div class=\"muted\" style=\"font-size:20px\">30+ visits</div></div>\n        <div class=\"bar\" data-grow=\"1.6\" style=\"height:500px;background:var(--copper)\"><div class=\"rate\" style=\"color:var(--ink)\">2.5\u00d7</div><div class=\"sub\" style=\"color:rgba(22,19,15,.75)\">+600 coin entry bonus</div><div class=\"perk\" data-in=\"3.3\" style=\"background:var(--ink);color:var(--copper2)\">Dessert every visit</div></div></div>\n    </div>\n    <div class=\"abs p\" data-in=\"3.8\" style=\"left:140px;bottom:70px;font-size:24px\">The redemption rate stays 20 coins = AED 1 at every tier. Names and thresholds are yours to set.</div>\n  </div>\n  <style>\n    #tiers .tier{display:flex;flex-direction:column;justify-content:flex-end}\n    #tiers .tl{margin-bottom:18px}\n    #tiers .bar{border-radius:24px 24px 6px 6px;padding:28px;transform-origin:50% 100%;position:relative}\n    #tiers .rate{font-family:Gelasio,Georgia,serif;font-size:64px;color:var(--copper2);line-height:1}\n    #tiers .sub{font-size:19px;color:var(--muted-d);margin-top:10px}\n    #tiers .perk{position:absolute;left:28px;right:28px;bottom:26px;background:rgba(22,19,15,.55);color:var(--copper2);border-radius:14px;padding:12px 14px;font-size:18px;font-weight:600}\n  </style>\n</section>", "redeem": "<!-- 8 REDEMPTION -->\n<section class=\"scene light\" data-dur=\"6.8\" id=\"redeem\">\n  <div class=\"glow\" data-drift=\"1\" style=\"width:1200px;height:1200px;left:800px;top:-300px\"></div>\n  <div class=\"stage\">\n    <div class=\"abs\" style=\"left:150px;top:290px;width:820px\">\n      <div class=\"eyebrow\" data-in=\"0.1\">Simple redemption</div>\n      <h2 data-in=\"0.3\" style=\"margin-top:22px\">One swipe, straight off the bill.</h2>\n      <div class=\"p\" data-in=\"0.8\" style=\"margin-top:32px\">No codes, no vouchers, no barcodes. Same payment methods, same settlement, same receipt.</div>\n    </div>\n    <div class=\"abs card-l\" data-in=\"0.5\" data-y=\"80\" data-d=\"0.9\" style=\"left:1120px;top:110px;width:660px;padding:44px\">\n      <div class=\"row\" style=\"justify-content:space-between;align-items:center\"><div style=\"font-size:30px;font-weight:600\">BKRY</div><div class=\"muted\" style=\"font-size:20px\">Table 12</div></div>\n      <div style=\"m